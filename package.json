{
  "name": "planning-poker-game",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n shared,socket,web -c blue,green,magenta \"pnpm --filter shared dev\" \"cross-env USE_MEMORY_REPO=true pnpm --filter socket dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter shared build && pnpm -r --filter=!shared build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "7",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.9"
}
