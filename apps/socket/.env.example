# Supabase Postgres direct connection string (port 5432). Not used when USE_MEMORY_REPO=true.
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

PORT=4000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:3000"

# When true, the socket server keeps all game state in memory only (no Postgres/Prisma
# required). Used for local development and automated tests, per PLAN.md §3.
USE_MEMORY_REPO=true
